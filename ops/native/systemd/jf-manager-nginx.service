[Unit]
Description=JF-Manager Nginx (Oberfläche, Sicherheitsheader, Proxy zum Backend)
PartOf=jf-manager.target
After=network-online.target jf-manager-web.service

[Service]
Type=forking
PIDFile=/run/jf-manager-nginx.pid
ExecStartPre=/usr/sbin/nginx -t -q -c @ETC@/nginx/nginx.conf
ExecStart=/usr/sbin/nginx -c @ETC@/nginx/nginx.conf
ExecReload=/usr/sbin/nginx -s reload -c @ETC@/nginx/nginx.conf
ExecStop=-/sbin/start-stop-daemon --quiet --stop --retry QUIT/5 --pidfile /run/jf-manager-nginx.pid
Restart=on-failure
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=jf-manager.target
