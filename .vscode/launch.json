{
    // Local development. Secrets (DJANGO_SECRET_KEY, FIELD_ENCRYPTION_KEY) come
    // from the git-ignored backend/.env, see docs/getting-started.md.
    // Open the app at http://localhost:5173: Vite proxies /api, /admin and
    // /static to Django so session and CSRF cookies share one origin.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend: Django",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/manage.py",
            "cwd": "${workspaceFolder}/backend",
            "args": ["runserver", "127.0.0.1:8000"],
            "django": true,
            "justMyCode": true,
            "preLaunchTask": "backend: worker",
            "envFile": "${workspaceFolder}/backend/.env",
            "env": {
                "PYTHONUNBUFFERED": "1",
                "DEBUG": "True",
                "DEV_ALLOW_UNREADABLE_SMTP": "True",
                "DJANGO_SETTINGS_MODULE": "jf_manager_backend.settings"
            }
        },
        {
            "name": "Frontend: Vite",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/frontend",
            "runtimeExecutable": "/Users/lukasbisdorf/.nvm/versions/node/v24.9.0/bin/npm",
            "runtimeArgs": ["run", "dev"],
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal",
            "env": {
                "NODE_ENV": "development",
                "PATH": "/Users/lukasbisdorf/.nvm/versions/node/v24.9.0/bin:/usr/local/bin:/usr/bin:/bin"
            }
        },
        {
            "name": "Frontend: Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend/src",
            "skipFiles": ["<node_internals>/**"],
            "sourceMaps": true,
            "preLaunchTask": "frontend: vite"
        },
        {
            "name": "Demo: Backend mit Beispieldaten",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/demo.py",
            "cwd": "${workspaceFolder}/backend",
            "args": ["--port", "8011"],
            "justMyCode": true,
            "console": "integratedTerminal",
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "Demo: Frontend",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/frontend",
            "runtimeExecutable": "/Users/lukasbisdorf/.nvm/versions/node/v24.9.0/bin/npm",
            "runtimeArgs": ["run", "dev"],
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal",
            "env": {
                "NODE_ENV": "development",
                "VITE_BACKEND_URL": "http://127.0.0.1:8011",
                "PATH": "/Users/lukasbisdorf/.nvm/versions/node/v24.9.0/bin:/usr/local/bin:/usr/bin:/bin"
            }
        },
        {
            "name": "Backend: Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/manage.py",
            "cwd": "${workspaceFolder}/backend",
            "args": ["test", "api_tests"],
            "django": true,
            "justMyCode": true,
            "envFile": "${workspaceFolder}/backend/.env",
            "env": {
                "DJANGO_SETTINGS_MODULE": "jf_manager_backend.settings",
                "REDIS_URL": "none"
            }
        },
        {
            "name": "Frontend: Unit-Tests",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/frontend",
            "runtimeExecutable": "/Users/lukasbisdorf/.nvm/versions/node/v24.9.0/bin/npm",
            "runtimeArgs": ["run", "test:unit", "--", "--run"],
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal",
            "env": {
                "NODE_ENV": "test",
                "PATH": "/Users/lukasbisdorf/.nvm/versions/node/v24.9.0/bin:/usr/local/bin:/usr/bin:/bin"
            }
        }
    ],
    "compounds": [
        {
            "name": "JF-Manager: Backend + Frontend",
            "configurations": ["Backend: Django", "Frontend: Chrome"],
            "stopAll": true
        },
        {
            "name": "Demo: Backend + Frontend",
            "configurations": ["Demo: Backend mit Beispieldaten", "Demo: Frontend"],
            "stopAll": true
        }
    ]
}
