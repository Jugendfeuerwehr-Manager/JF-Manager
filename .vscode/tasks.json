{
    // Backend tasks run through backend/dev_env.py: backend/.env takes precedence over
    // inherited variables, and stored secrets are checked before start. See docs/getting-started.md.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "frontend: vite",
            "type": "shell",
            "command": "/Users/lukasbisdorf/.nvm/versions/node/v24.9.0/bin/npm",
            "args": ["run", "dev"],
            "group": "build",
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*VITE.*$",
                    "endsPattern": "^.*Local:.*$"
                }
            },
            "options": {
                "cwd": "${workspaceFolder}/frontend",
                "shell": {
                    "executable": "/bin/zsh",
                    "args": ["-c"]
                },
                "env": {
                    "PATH": "/Users/lukasbisdorf/.nvm/versions/node/v24.9.0/bin:/usr/local/bin:/usr/bin:/bin",
                    "NODE_ENV": "development"
                }
            }
        },
        {
            "label": "redis: start locally",
            "type": "shell",
            // Reuses a running Redis; otherwise starts one without persistence,
            // so no dump.rdb lands in the repository.
            "command": "if redis-cli -p 6379 ping >/dev/null 2>&1; then echo 'Ready to accept connections (already running)'; tail -f /dev/null; else redis-server --port 6379 --save '' --appendonly no --loglevel notice; fi",
            "isBackground": true,
            "problemMatcher": {
                "owner": "redis",
                "pattern": { "regexp": "^$" },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*$",
                    "endsPattern": "^.*Ready to accept connections.*$"
                }
            },
            "options": {
                "shell": {
                    "executable": "/bin/zsh",
                    "args": ["-c"]
                },
                "env": {
                    "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
                }
            },
            "presentation": {
                "group": "django-dev",
                "reveal": "silent",
                "panel": "dedicated"
            }
        },
        {
            "label": "backend: env",
            "type": "shell",
            "command": "pipenv run python dev_env.py ensure",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}/backend",
                "shell": {
                    "executable": "/bin/zsh",
                    "args": ["-c"]
                },
                "env": {
                    "DEV_ALLOW_UNREADABLE_SMTP": "True",
                    "PIPENV_DONT_LOAD_ENV": "1",
                    "PIPENV_VERBOSITY": "-1",
                    "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
                }
            },
            "presentation": {
                "group": "django-dev",
                "reveal": "silent",
                "panel": "dedicated"
            }
        },
        {
            "label": "backend: migrate",
            "type": "shell",
            "command": "pipenv run python dev_env.py run python manage.py migrate",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}/backend",
                "shell": {
                    "executable": "/bin/zsh",
                    "args": ["-c"]
                },
                "env": {
                    "DEV_ALLOW_UNREADABLE_SMTP": "True",
                    "PIPENV_DONT_LOAD_ENV": "1",
                    "PIPENV_VERBOSITY": "-1",
                    "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
                }
            },
            "presentation": {
                "group": "django-dev",
                "reveal": "silent",
                "panel": "dedicated"
            }
        },
        {
            // Fails with a hint when stored secrets do not match the key in backend/.env.
            "label": "backend: check keys",
            "type": "shell",
            "command": "pipenv run python dev_env.py check",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}/backend",
                "shell": {
                    "executable": "/bin/zsh",
                    "args": ["-c"]
                },
                "env": {
                    "DEV_ALLOW_UNREADABLE_SMTP": "True",
                    "PIPENV_DONT_LOAD_ENV": "1",
                    "PIPENV_VERBOSITY": "-1",
                    "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
                }
            },
            "presentation": {
                "group": "django-dev",
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "backend: worker",
            "type": "shell",
            "command": "pipenv run python dev_env.py run python manage.py rqworker default",
            "isBackground": true,
            "problemMatcher": {
                "owner": "rq",
                "pattern": { "regexp": "^$" },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*$",
                    "endsPattern": "^.*Listening on.*$"
                }
            },
            "dependsOn": ["redis: start locally", "backend: env", "backend: migrate", "backend: check keys"],
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${workspaceFolder}/backend",
                "shell": {
                    "executable": "/bin/zsh",
                    "args": ["-c"]
                },
                "env": {
                    "DEV_ALLOW_UNREADABLE_SMTP": "True",
                    "PIPENV_DONT_LOAD_ENV": "1",
                    "PIPENV_VERBOSITY": "-1",
                    "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
                }
            },
            "presentation": {
                "group": "django-dev",
                "reveal": "silent",
                "panel": "dedicated"
            }
        },
        {
            "label": "dev: Zurücksetzen und Demodaten",
            "type": "shell",
            "command": "pipenv run python dev_env.py reset --confirm ${input:confirmReset}",
            "problemMatcher": [],
            "dependsOn": ["redis: start locally"],
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${workspaceFolder}/backend",
                "shell": {
                    "executable": "/bin/zsh",
                    "args": ["-c"]
                },
                "env": {
                    "DEV_ALLOW_UNREADABLE_SMTP": "True",
                    "PIPENV_DONT_LOAD_ENV": "1",
                    "PIPENV_VERBOSITY": "-1",
                    "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
                }
            },
            "presentation": {
                "group": "django-dev",
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "dev: Anmeldecode (Demo)",
            "type": "shell",
            "command": "pipenv run python dev_env.py totp ${input:demoUser}",
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}/backend",
                "shell": {
                    "executable": "/bin/zsh",
                    "args": ["-c"]
                },
                "env": {
                    "DEV_ALLOW_UNREADABLE_SMTP": "True",
                    "PIPENV_DONT_LOAD_ENV": "1",
                    "PIPENV_VERBOSITY": "-1",
                    "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
                }
            },
            "presentation": {
                "group": "django-dev",
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ],
    "inputs": [
        {
            "id": "confirmReset",
            "type": "pickString",
            "description": "Lokale Datenbank, Uploads und Cache löschen und Demodaten laden?",
            "options": ["nein", "ja"],
            "default": "nein"
        },
        {
            "id": "demoUser",
            "type": "pickString",
            "description": "Demokonto mit Authenticator",
            "options": ["admin", "jugendwart", "leitung.mitte", "leitung.nord", "leitung.kinder"],
            "default": "admin"
        }
    ]
}
